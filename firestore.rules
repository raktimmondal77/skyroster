rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read and write to the teams collection
    // (Since there is no user login/auth system right now)
    match /teams/{teamId} {
      allow read, create: if true;
      allow update: if true;
      allow delete: if false; // Prevent malicious destruction of team documents
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
